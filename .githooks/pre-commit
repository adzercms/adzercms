#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

refuse() {
    [ -z "$2" ] || { printf '%s:\n%s\n' "$1" "$2"; exit 1; }
}

unpaired=$(for doc in $(git diff --cached --name-only --diff-filter=ACMRD -- README.md 'docs/*.md' | grep -v '\.ru\.md$' || true); do
    if git diff --cached --quiet -- "${doc%.md}.ru.md"; then printf '%s\n' "$doc"; fi
done)
refuse 'README and docs/ change together with the Russian translation *.ru.md' "$unpaired"

twins=$(git diff --cached --name-only --diff-filter=ACMRD | sed -n -e 's#^packages/skeleton/##p' -e '/^packages\//!p' | sort -u | while read -r file; do
    head=$(git rev-parse -q --verify "HEAD:$file" || true)
    [ -n "$head" ] && [ "$head" = "$(git rev-parse -q --verify "HEAD:packages/skeleton/$file" || true)" ] \
        && [ "$(git rev-parse -q --verify ":$file" || true)" != "$(git rev-parse -q --verify ":packages/skeleton/$file" || true)" ] \
        && printf '%s\n' "$file"
done || true)
refuse 'a file of the project template and its twin in the development application change together' "$twins"

[ -x vendor/bin/adzercms-pre-commit ] || { printf 'commit gate needs composer install\n'; exit 1; }
exec vendor/bin/adzercms-pre-commit
