{% extends '@Theme/panel.html.twig' %}

{% import '@Leads/_fields.html.twig' as fields %}

{% block title %}{{ 'leads.lead.title'|trans({number: lead.id}) }}{% endblock %}

{% block heading %}<span class="record-title">{{ 'leads.lead.title'|trans({number: lead.id}) }} {{ badge(lead.stage) }}</span>{% endblock %}

{% block actions %}
    <form method="post" action="{{ path('admin_lead_drop', {id: lead.id}) }}"
          data-confirm="{{ 'leads.lead.drop_confirm'|trans({number: lead.id}) }}">
        {{ csrf_field() }}<button type="submit" class="danger">{{ 'leads.lead.drop'|trans }}</button>
    </form>
    <a class="button secondary" href="{{ path('admin_leads') }}">{{ 'core.action.to_list'|trans }}</a>
{% endblock %}

{% block page %}
<div class="section">
    <div class="section-head">
        <h3>{{ 'leads.lead.client'|trans }}</h3>
    </div>
    <div class="info-grid">
        <div class="info-item">
            <span class="info-label">{{ 'leads.field.name'|trans }}</span>
            <span class="info-value">{{ cell(lead.name) }}</span>
        </div>
        {% for contact in contacts %}
            {% set kind = contact[0] %}
            <div class="info-item">
                <span class="info-label">{{ kind.label|trans }}</span>
                <a class="info-value" href="{{ kind.href(contact[1]) }}">{{ contact[1] }}</a>
            </div>
        {% endfor %}
    </div>
</div>

<div class="section">
    <div class="section-head">
        <h3>{{ 'leads.lead.details'|trans }}</h3>
    </div>
    <div class="info-grid">
        <div class="info-item">
            <span class="info-label">{{ 'leads.field.topic'|trans }}</span>
            <span class="info-value">{{ cell(lead.topic) }}</span>
        </div>
        <div class="info-item">
            <span class="info-label">{{ 'leads.field.page'|trans }}</span>
            {% if lead.page %}
                <a class="info-value" href="{{ lead.page }}" target="_blank" rel="noopener noreferrer">{{ lead.page }}</a>
            {% else %}
                <span class="info-value">{{ cell(null) }}</span>
            {% endif %}
        </div>
        <div class="info-item">
            <span class="info-label">{{ 'leads.field.arrived'|trans }}</span>
            <span class="info-value">{{ 'core.moment.day_time'|trans({at: lead.arrived}) }}</span>
        </div>
        {% for detail in details %}
            <div class="info-item">
                <span class="info-label">{{ detail.label|trans }}</span>
                <span class="info-value">{{ detail.value }}</span>
            </div>
        {% endfor %}
    </div>
</div>

{% if others %}
    <div class="section">
        <div class="section-head">
            <h3>{{ 'leads.lead.others'|trans }}</h3>
        </div>
        <div class="info-grid">
            {% for other in others %}
                <div class="info-item">
                    <span class="info-label">{{ 'core.moment.day_time'|trans({at: other.arrived}) }}</span>
                    <span class="info-value"><a href="{{ path('admin_lead', {id: other.id}) }}">{{ 'leads.lead.title'|trans({number: other.id}) }}</a> {{ badge(other.stage) }}</span>
                    {{ caption(other.topic) }}
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}

<div class="section">
    <div class="section-head">
        <h3>{{ 'leads.lead.handling'|trans }}</h3>
    </div>
    {% set refused = stages|filter(stage => stage.group == enum('AdzerCMS\\Leads\\StageGroup').Refused)|map(stage => stage.id) %}
    <form method="post" action="{{ path('admin_lead_save', {id: lead.id}) }}">
        {{ csrf_field() }}
        <div class="fields">
            <label>{{ 'leads.field.stage'|trans }}
                <select name="stage">
                    {% for stage in stages %}
                        <option value="{{ stage.id }}" {{ (input.stage ?? lead.stage.id) == stage.id ? 'selected' }}>{{ stage.label|trans }}</option>
                    {% endfor %}
                </select>
                {{ fields.refusal(refusals, 'stage') }}
            </label>
            <label>{{ 'leads.field.manager'|trans }}
                <select name="manager">
                    <option value="">{{ cell(null) }}</option>
                    {% for id, login in managers %}
                        <option value="{{ id }}" {{ (input.manager ?? lead.manager.id ?? '') == id ? 'selected' }}>{{ login }}</option>
                    {% endfor %}
                </select>
                {{ fields.refusal(refusals, 'manager') }}
            </label>
            <label>{{ 'leads.field.due'|trans }}
                <input type="datetime-local" name="due" value="{{ input.due ?? (lead.due ? lead.due|date(constant('AdzerCMS\\Leads\\Handling::DUE_FORMAT')) : '') }}">
                {{ fields.refusal(refusals, 'due') }}
            </label>
            <label>{{ 'leads.field.amount'|trans }}
                <input type="text" name="amount" inputmode="decimal" value="{{ input.amount ?? (lead.amount is null ? '' : lead.amount|plain) }}">
                {{ fields.refusal(refusals, 'amount') }}
            </label>
            <label class="field-wide" data-when="stage={{ refused|join('|') }}">{{ 'leads.field.reason'|trans }}
                <input type="text" name="reason" list="lead-reasons" maxlength="{{ constant('AdzerCMS\\Leads\\Entity\\Lead::REASON') }}" value="{{ input.reason ?? lead.reason }}">
                <datalist id="lead-reasons">
                    {% for reason in reasons %}<option value="{{ reason }}"></option>{% endfor %}
                </datalist>
                {{ fields.refusal(refusals, 'reason') }}
            </label>
        </div>
        <button type="submit">{{ 'core.action.save'|trans }}</button>
    </form>
</div>

<div class="section">
    <div class="section-head">
        <h3>{{ 'leads.lead.feed'|trans }}</h3>
    </div>
    <div class="chat">
        {% if lead.message %}
            <div class="chat-message other">
                <div class="chat-bubble">
                    <div class="chat-head">
                        <span class="chat-author">{{ lead.name ?? 'leads.lead.client'|trans }}</span>
                        <span class="chat-time">{{ 'core.moment.day_time'|trans({at: lead.arrived}) }}</span>
                    </div>
                    <div class="chat-text">{{ lead.message|nl2br }}</div>
                </div>
            </div>
        {% endif %}
        {% for entry in entries %}
            <div class="chat-message own">
                <div class="chat-bubble">
                    <div class="chat-head">
                        <span class="chat-author">{{ entry.author ? authors[entry.author.id] : cell(null) }}</span>
                        <span class="chat-time">{{ 'core.moment.day_time'|trans({at: entry.written}) }}</span>
                    </div>
                    <div class="chat-text">
                        {% if entry.note %}{{ entry.note|nl2br }}{% endif %}
                        {% for change in entry.changes %}
                            <div>{{ ('leads.field.' ~ change.field)|trans }}: {{ cell(change.was) }} → {{ cell(change.now) }}</div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    <form class="chat-reply" method="post" action="{{ path('admin_lead_note', {id: lead.id}) }}">
        {{ csrf_field() }}
        <label>{{ 'leads.lead.note'|trans }}
            <textarea name="note" rows="3" maxlength="{{ constant('AdzerCMS\\Leads\\Entity\\LeadEntry::NOTE') }}" required></textarea>
        </label>
        <button type="submit">{{ 'leads.lead.note_add'|trans }}</button>
    </form>
</div>
{% endblock %}
