{% embed '@Theme/_table.html.twig' with {live: true} %}
    {% block row %}
        <tr class="clickable-row" data-href="{{ path('admin_lead', {id: row.id}) }}">
            <td class="{{ table.aside('number') }}"><strong>{{ row.id }}</strong>{{ caption(row.name) }}</td>
            <td class="{{ table.aside('topic') }}">{{ cell(row.topic) }}</td>
            <td class="{{ table.aside('contacts') }}">{{ cell([row.phone, row.email]|filter(contact => contact)) }}</td>
            {% for column in extra %}
                <td class="{{ table.aside(column.key) }}">{{ cell(cells[row.id][column.key] ?? null) }}</td>
            {% endfor %}
            <td class="{{ table.aside('amount') }}">{{ cell(row.amount is null ? null : row.amount|money) }}</td>
            <td class="{{ table.aside('manager') }}">{{ cell(row.manager ? managers[row.manager.id] : null) }}</td>
            <td class="{{ table.aside('due') }} {{ row.isOverdue ? 'minus' }}">{{ moment(row.due) }}</td>
            <td class="{{ table.aside('arrived') }}">{{ moment(row.arrived) }}</td>
            <td class="{{ table.aside('stage') }}">{{ badge(row.stage) }}</td>
        </tr>
    {% endblock %}
{% endembed %}
