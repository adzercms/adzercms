{
    "name": "adzercms/turnstile",
    "type": "adzercms-module",
    "description": "Cloudflare Turnstile captcha for AdzerCMS forms",
    "keywords": [
        "adzercms",
        "symfony",
        "captcha",
        "turnstile",
        "cloudflare"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "adzercms/contracts": "^1.0",
        "symfony/dependency-injection": "7.4.*"
    },
    "provide": {
        "adzercms/captcha-implementation": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\Turnstile\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\Turnstile\\TurnstileBundle",
            "categories": ["security"]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
