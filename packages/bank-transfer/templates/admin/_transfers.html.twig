{% embed '@Theme/_table.html.twig' %}
    {% block row %}
        <tr class="clickable-row" data-record="{{ path('admin_bank_transfer', {number: row.number}) }}">
            <td class="{{ table.aside('comment') }}">{{ cell(comments[row.number]) }}</td>
            <td class="{{ table.aside('amount') }}">{{ row.amount|money }}</td>
            <td class="{{ table.aside('created') }}">{{ moment(row.createdAt) }}</td>
        </tr>
    {% endblock %}
{% endembed %}
