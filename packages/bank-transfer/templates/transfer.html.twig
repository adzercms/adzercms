{% extends '@Theme/page.html.twig' %}

{% block title %}{{ 'bank_transfer.page.title'|trans({amount: payment.amount|money}) }}{% endblock %}

{% block page %}
<div class="pay">
    {% if note %}<p>{{ note }}</p>{% endif %}
    {% for key, value in {card: [card, card], phone: [phone, phone], comment: [comment, comment], amount: [payment.amount|plain, payment.amount|money]} %}
        {% if value[0] %}
            <p class="detail">
                <span>{{ ('bank_transfer.page.' ~ key)|trans }}:</span>
                <data id="transfer-{{ key }}" value="{{ value[0] }}">{{ value[1] }}</data>
                {% include '@Theme/_copy.html.twig' with {target: '#transfer-' ~ key, small: true} only %}
            </p>
        {% endif %}
    {% endfor %}
    {% if phone and bank %}<p class="muted">{{ 'bank_transfer.page.bank'|trans({bank: bank}) }}</p>{% endif %}
    <p class="muted">{{ 'bank_transfer.page.credit'|trans }}</p>

    <div class="pay-methods">
        <a class="button secondary" href="{{ payment.back }}">{{ 'bank_transfer.page.back'|trans }}</a>
    </div>
</div>
{% endblock %}
