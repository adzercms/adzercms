{% set names = logins(rows|map(row => row.user)) %}
{% embed '@Theme/_table.html.twig' %}
    {% block row %}
        <tr>
            <td class="{{ table.aside('at') }}">{{ moment(row.createdAt) }}</td>
            <td class="{{ table.aside('event') }}">{{ row.event|trans }}</td>
            <td class="{{ table.aside('user') }}">
                {%- if row.user -%}
                    {% include '@Theme/_user.html.twig' with {user: row.user, name: names[row.user.id]} only %}
                {%- else -%}
                    {{ blank() }}
                {%- endif -%}
            </td>
            <td class="{{ table.aside('recipient') }}">{{ row.recipient }}</td>
            <td class="{{ table.aside('body') }}">{{ row.body }}</td>
            <td class="{{ table.aside('status') }}">{{ badge(row.status) }}{{ caption(row.error) }}</td>
        </tr>
    {% endblock %}

{% endembed %}
