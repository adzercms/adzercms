{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ 'mailing.title'|trans }}{% endblock %}

{% block page %}
{% include '@Theme/_tabs.html.twig' with {tabs: [
    {label: 'mailing.broadcast', href: path('admin_notices'), active: view == 'broadcast'},
    {label: 'mailing.journal', href: path('admin_notices', {view: 'journal', tab: tab}), active: view == 'journal'},
]} only %}

{% if view == 'broadcast' %}
    <form method="post" action="{{ path('admin_broadcast') }}">
        {{ csrf_field() }}

        {% include '@Mailing/admin/_broadcast_scope.html.twig' %}

        <label>{{ 'mailing.body'|trans }}
            <textarea name="body" maxlength="{{ limit }}" required></textarea>
        </label>

        <button type="submit">{{ 'mailing.send'|trans }}</button>
    </form>
{% else %}
    {% include '@Theme/_tabs.html.twig' with {tabs: channels|map(item => {label: item.label, href: path('admin_notices', {view: 'journal', tab: item.key}), active: tab == item.key})} only %}

    {% if not configured %}
        <p class="flash flash-error">{{ 'mailing.unconfigured'|trans }}</p>
    {% elseif tab == sms %}
        {% include '@Mailing/admin/_sms_account.html.twig' %}
    {% endif %}

    {% include '@Mailing/admin/_notices.html.twig' %}
{% endif %}
{% endblock %}
