{
    "name": "adzercms/mailing",
    "type": "adzercms-module",
    "description": "Mailings for AdzerCMS: send messages to the users you choose by email, SMS and messenger bots",
    "keywords": [
        "adzercms",
        "symfony",
        "mailing",
        "broadcast",
        "newsletter"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "adzercms/contracts": "^1.0",
        "adzercms/core": "^1.0",
        "adzercms/theme-implementation": "^1.0",
        "symfony/dependency-injection": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/security-http": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/translation-contracts": "^3.7"
    },
    "require-dev": {
        "adzercms/admin": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\Mailing\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\Mailing\\MailingBundle",
            "categories": ["messaging", "marketing"]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
