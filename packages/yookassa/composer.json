{
    "name": "adzercms/yookassa",
    "type": "adzercms-module",
    "description": "YooKassa acquiring for AdzerCMS payments",
    "keywords": [
        "adzercms",
        "symfony",
        "payments",
        "acquiring",
        "yookassa"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "adzercms/contracts": "^1.0",
        "adzercms/core": "^1.0",
        "adzercms/payments": "^1.0",
        "symfony/dependency-injection": "7.4.*",
        "symfony/http-client-contracts": "^3.7",
        "symfony/http-foundation": "7.4.*",
        "symfony/translation": "7.4.*"
    },
    "provide": {
        "adzercms/payment-implementation": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\YooKassa\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\YooKassa\\YooKassaBundle"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
