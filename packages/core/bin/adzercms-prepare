#!/bin/sh
set -eu

checked=1
[ "${1:-}" != --unchecked ] || { checked=; shift; }
copy=$(cd "${1:?copy of the instance}" && pwd -P)
shift
: "${APP_BUILD:?build of the copy}"
scripts=$(dirname "$(readlink -f "$0")")

[ ! -f .env.local ] || cp -p .env.local "$copy/"
if "$scripts/adzercms-stale" "$copy"; then
    changed=$("$scripts/adzercms-patched" "$copy")
    bin/php "$(command -v composer)" install --working-dir="$copy" --no-interaction --no-progress --no-scripts
    # shellcheck disable=SC2086
    [ -z "$changed" ] || bin/php "$(command -v composer)" reinstall --working-dir="$copy" --no-interaction --no-progress $changed
    [ -z "$checked" ] || "$copy/vendor/bin/adzercms-verify" "$copy"
fi
cd "$copy"
[ $# -gt 0 ] || set -- ''
for assignments; do
    # shellcheck disable=SC2086
    env $assignments vendor/bin/adzercms-build
done
