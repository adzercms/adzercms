#!/bin/sh
set -eu

copy=${1:?copy of the instance}
[ -n "$(ls -d "$copy"/modules/*/ 2>/dev/null)" ] || grep -qs '<testsuite ' "$copy/phpunit.dist.xml" || exit 0
mkdir -p "$copy/var"
ln -sfn "$(pwd -P)/var/tests.lock" "$copy/var/tests.lock"
cd "$copy"
bin/php bin/console cache:warmup --env=test
bin/php bin/console importmap:install --no-interaction --env=test
vendor/bin/adzercms-check
[ ! -f phpunit.dist.xml ] || vendor/bin/adzercms-suites
