#!/bin/sh
set -eu

[ -f .env.local ] || exit 0

root=$(pwd -P)
if [ "${ADZERCMS_ENTRY:-}" != "$root" ]; then
    mkdir -p var/lock
    exec 9> var/lock/refresh 8> var/lock/entry 7> var/lock/serve 6> var/lock/served
    flock 9
    flock 8
    flock 7
    flock 6
    ADZERCMS_ENTRY=$root
    export ADZERCMS_ENTRY
fi

stamp=var/composer.installed
locked=$(sha256sum composer.lock | cut -d' ' -f1)

if [ "$(cat "$stamp" 2>/dev/null || true)" != "$locked" ]; then
    bin/php "$(command -v composer)" install --no-interaction --no-progress --no-scripts
    printf '%s\n' "$locked" > "$stamp"
    exec "$0"
fi

patched=var/patches.installed

if { [ -f patches.lock.json ] || [ -f "$patched" ]; } && ! cmp -s patches.lock.json "$patched"; then
    # shellcheck disable=SC2016
    changed=$(bin/php -r '
        $patches = static fn (string $file): array => is_file($file) ? json_decode(file_get_contents($file), true)["patches"] ?? [] : [];
        [$new, $old] = [$patches("patches.lock.json"), $patches($argv[1])];
        echo implode(" ", array_filter(array_keys($new + $old), static fn (string $package): bool => ($new[$package] ?? null) != ($old[$package] ?? null) && is_dir("vendor/".$package)));
    ' "$patched")
    # shellcheck disable=SC2086
    [ -z "$changed" ] || bin/php "$(command -v composer)" reinstall --no-interaction --no-progress $changed
    if [ -f patches.lock.json ]; then cp patches.lock.json "$patched"; else rm "$patched"; fi
    exec "$0"
fi

APP_BUILD=$(date +%Y%m%d%H%M%S)-$$
export APP_BUILD

bin/php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration
bin/php bin/console doctrine:schema:validate || true
bin/php bin/console cache:warmup
bin/php bin/console importmap:install --no-interaction
bin/php bin/console asset-map:compile --no-interaction
bin/php bin/console adzercms:cache
