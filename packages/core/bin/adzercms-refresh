#!/bin/sh
set -eu

[ -f .env.local ] || exit 0

root=$(pwd -P)
[ "${ADZERCMS_REFRESHED:-}" != "$root" ] || exit 0
scripts=$(dirname "$0")
next=$root/var/next
stamp=var/composer.installed
patched=var/patches.installed

held=
if [ "${ADZERCMS_ENTRY:-}" = "$root" ]; then
    held=1
else
    mkdir -p var/lock
    exec 9> var/lock/refresh 8> var/lock/entry 7> var/lock/serve 6> var/lock/served
    flock 9
fi

rm -rf "$next"
trap 'rm -rf "$next"' EXIT
mkdir -p "$next"
sed 's#^#/#' "$scripts/../config/stage.exclude" | rsync -a --exclude-from=- ./ "$next/"
cp -p .env.local "$next/"

if [ "$(cat "$stamp" 2>/dev/null || true)" != "$(sha256sum composer.lock | cut -d' ' -f1)" ] \
    || { { [ -f patches.lock.json ] || [ -f "$patched" ]; } && ! cmp -s patches.lock.json "$patched"; }; then
    changed=$("$scripts/adzercms-patched")
    bin/php "$(command -v composer)" install --working-dir="$next" --no-interaction --no-progress --no-scripts
    # shellcheck disable=SC2086
    [ -z "$changed" ] || bin/php "$(command -v composer)" reinstall --working-dir="$next" --no-interaction --no-progress $changed
    [ -n "$held" ] || "$next/vendor/bin/adzercms-verify" "$next"
fi

APP_BUILD=$(date +%Y%m%d%H%M%S)-$$
export APP_BUILD
(cd "$next" && vendor/bin/adzercms-build)

if [ -z "$held" ]; then
    flock 8
    flock 7
    flock 6
    ADZERCMS_ENTRY=$root
    export ADZERCMS_ENTRY
fi
"$next/vendor/bin/adzercms-adopt" "$next"
[ -n "$held" ] || exec 8>&- 7>&- 6>&-

bin/php bin/console doctrine:schema:validate || true
