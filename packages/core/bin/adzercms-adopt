#!/bin/sh
set -eu

copy=$(cd "${1:?copy of the instance}" && pwd -P)
: "${APP_BUILD:?build of the copy}"

if "$(dirname "$(readlink -f "$0")")/adzercms-stale" "$copy"; then
    mv vendor "$copy/vendor.live"
    mv "$copy/vendor" vendor
    sha256sum "$copy/composer.lock" | cut -d' ' -f1 > var/composer.installed
    if [ -f "$copy/patches.lock.json" ]; then cp "$copy/patches.lock.json" var/patches.installed; else rm -f var/patches.installed; fi
fi

for build in "$copy"/var/cache/*/"$APP_BUILD"; do
    [ -d "$build" ] || continue
    builds=var/cache/$(basename "$(dirname "$build")")
    mkdir -p "$builds"
    mv "$build" "$builds/"
done
take() {
    [ -d "$copy/$1" ] || return 0
    mkdir -p "$1"
    rsync -a ${2:+"$2"} "$copy/$1/" "$1/"
}
take public/assets
take assets/vendor --delete

bin/php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration
bin/php bin/console adzercms:cache
