{% set services = counters|map(counter => counter.name|trans)|join(', ') %}
<link rel="stylesheet" href="{{ asset('vendor/vanilla-cookieconsent/dist/cookieconsent.css') }}">
<script type="module" src="{{ asset('bundles/core/consent.js') }}" data-consent="{{ {
    language: app.request.locale,
    texts: {
        title: 'core.consent.title'|trans,
        description: 'core.consent.description'|trans({services: services|e, policy: legal('privacy', 'core.consent.policy'|trans)}),
        accept: 'core.consent.accept'|trans,
    },
    counters: counters|map(counter => {entry: counter.entry, settings: counter.settings}),
}|json_encode }}"></script>
