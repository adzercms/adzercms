{% extends '@Core/notice/_layout.html.twig' %}
{% import '@Core/notice/_macros.html.twig' as mail %}

{% block subject %}{{ 'core.notice.password_issued.subject'|trans({brand: brand.title}) }}{% endblock %}

{% block text %}
{{ 'core.notice.password_issued.body'|trans }}
{{ 'core.notice.password_issued.login'|trans({login: user.email ?? user.phone}) }}
{{ 'core.notice.password_issued.password'|trans({password: password}) }}
{{ cabinet('login', absolute: true) }}
{{ 'core.notice.password_issued.note'|trans }}
{% endblock %}

{% block content %}
<h2>{{ 'core.notice.password_issued.title'|trans }}</h2>
<p>{{ 'core.notice.password_issued.body'|trans }}</p>
<p>{{ 'core.notice.password_issued.login'|trans({login: user.email ?? user.phone}) }}<br>{{ 'core.notice.password_issued.password'|trans({password: password}) }}</p>
{% if cabinet('login', absolute: true) %}{{ mail.button(cabinet('login', absolute: true), 'core.notice.password_issued.action'|trans) }}{% endif %}
<p class="note">{{ 'core.notice.password_issued.note'|trans }}</p>
{% endblock %}
