{% extends '@Core/notice/_layout.html.twig' %}
{% import '@Core/notice/_macros.html.twig' as mail %}

{% block subject %}{{ 'core.notice.registration.subject'|trans({brand: brand.title}) }}{% endblock %}

{% block text %}
{{ 'core.notice.registration.body'|trans({brand: brand.title}) }} {{ url }}
{{ 'core.notice.lifetime'|trans({minutes: minutes}) }}
{{ 'core.notice.registration.note'|trans }}
{% endblock %}

{% block content %}
<h2>{{ 'core.notice.registration.title'|trans }}</h2>
<p>{{ 'core.notice.registration.body'|trans({brand: brand.title}) }}</p>
{{ mail.link(url, 'core.notice.registration.action'|trans, minutes) }}
<p class="note">{{ 'core.notice.registration.note'|trans }}</p>
{% endblock %}
