{% for decision in subject.decision.next %}
    {% set publish = decision == constant('AdzerCMS\\Core\\Moderation\\Decision::Published') %}
    <form hx-post="{{ action }}" hx-target="#record">
        {{ csrf_field() }}
        <input type="hidden" name="{{ constant('AdzerCMS\\Core\\Moderation\\Moderation::DECISION') }}" value="{{ decision.value }}">
        {% if not publish %}
            <div class="fields">
                <label class="field-wide">{{ 'core.moderation.reason'|trans }}
                    <textarea name="{{ constant('AdzerCMS\\Core\\Moderation\\Moderation::REASON') }}" required></textarea>
                </label>
            </div>
        {% endif %}
        <button type="submit" class="{{ publish ? '' : 'secondary' }}">{{ decision.action|trans }}</button>
    </form>
{% endfor %}
