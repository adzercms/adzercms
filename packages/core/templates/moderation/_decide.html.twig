{% set published = constant('AdzerCMS\\Core\\Moderation\\Decision::Published') %}
{% set reasoned = subject.decision.next|filter(decision => decision != published)|first %}
{% if subject.decision.next %}
    <form hx-post="{{ action }}" hx-target="#record">
        {{ csrf_field() }}
        {% if reasoned %}
            <div class="fields">
                <label class="field-wide">{{ reasoned.reason|trans }}
                    <textarea name="{{ constant('AdzerCMS\\Core\\Moderation\\Moderation::REASON') }}" required></textarea>
                </label>
            </div>
        {% endif %}
        {% for decision in subject.decision.next %}
            <button type="submit" name="{{ constant('AdzerCMS\\Core\\Moderation\\Moderation::DECISION') }}" value="{{ decision.value }}"{% if decision == published %} formnovalidate{% else %} class="secondary"{% endif %}>{{ decision.action|trans }}</button>
        {% endfor %}
    </form>
{% endif %}
