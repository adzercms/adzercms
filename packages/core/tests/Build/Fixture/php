#!/bin/sh
[ "${1:-}" != -r ] || exec "$PHP_BINARY" "$@"
here=$(pwd -P)
root=${here%/var/next}
if [ "$root" = "$here" ]; then call=$*; else call="copy $*"; fi
printf '%s%s\n' "$call" "${PROBE:+ PROBE=$PROBE}" >> "$root/calls"
case $* in
    'bin/console cache:warmup') mkdir -p "var/cache/prod_set/$APP_BUILD" ;;
    'bin/console importmap:install --no-interaction') mkdir -p assets/vendor && touch assets/vendor/library.js ;;
    'bin/console asset-map:compile --no-interaction') mkdir -p public/assets/set && printf '%s\n' "$APP_BUILD" > public/assets/set/manifest.json ;;
esac
for argument; do case $argument in --working-dir=*) copy=${argument#--working-dir=} ;; esac; done
[ -z "${copy:-}" ] || touch "$copy/vendor/installed"
