#!/bin/sh
[ "${1:-}" != -r ] || exec "$PHP_BINARY" "$@"
here=$(pwd -P)
root=${here%/var/verify}
if [ "$root" = "$here" ]; then call=$*; else call="copy $*"; fi
printf '%s\n' "$call" >> "$root/calls"
for argument; do case $argument in --working-dir=*) copy=${argument#--working-dir=} ;; esac; done
[ -n "${copy:-}" ] && [ ! -e "$copy/vendor/bin/adzercms-check" ] || exit 0
mkdir -p "$copy/vendor/bin"
ln -s "$(dirname "$(readlink -f "$0")")/check" "$copy/vendor/bin/adzercms-check"
