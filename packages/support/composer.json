{
    "name": "adzercms/support",
    "type": "adzercms-module",
    "description": "Support tickets for AdzerCMS with attachments, staff digest and help article suggestions",
    "keywords": [
        "adzercms",
        "symfony",
        "support",
        "helpdesk",
        "tickets"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "adzercms/contracts": "^1.0",
        "adzercms/core": "^1.0",
        "adzercms/theme-implementation": "^1.0",
        "doctrine/collections": "^3.1",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "doctrine/persistence": "^4.2",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client-contracts": "^3.7",
        "symfony/http-foundation": "7.4.*",
        "symfony/polyfill-php86": "^1.43",
        "symfony/routing": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-http": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/translation-contracts": "^3.7"
    },
    "require-dev": {
        "adzercms/admin": "^1.0",
        "adzercms/cabinet": "^1.0"
    },
    "suggest": {
        "adzercms/realtime": "tickets and their messages as live entities"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\Support\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\Support\\SupportBundle"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
