{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ 'support.menu.tickets'|trans }}{% endblock %}

{% block actions %}
    <a class="button" href="{{ path('support_ticket_new') }}">{{ 'support.ticket.new'|trans }}</a>
{% endblock %}

{% block page %}
{% include '@Theme/_tabs.html.twig' with {id: 'live-ticket-tabs', tabs: [
    {label: t('support.tab.active', {count: counts.active|default(0)}), href: path('support_tickets'), active: not archive},
    {label: t('support.tab.archive', {count: counts.archive|default(0)}), href: path('support_tickets', {tab: 'archive'}), active: archive},
]} only %}

{% include '@Support/support/_tickets.html.twig' %}
{% endblock %}
