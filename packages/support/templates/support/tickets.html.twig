{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ 'support.menu.tickets'|trans }}{% endblock %}

{% block actions %}
    <a class="button" href="{{ path('support_ticket_new') }}">{{ 'support.ticket.new'|trans }}</a>
{% endblock %}

{% block page %}
<nav class="tabs" id="live-ticket-tabs" data-live>
    <a class="tab {{ archive ? '' : 'active' }}" href="{{ path('support_tickets') }}">{{ 'support.tab.active'|trans({count: counts.active|default(0)}) }}</a>
    <a class="tab {{ archive ? 'active' }}" href="{{ path('support_tickets', {tab: 'archive'}) }}">{{ 'support.tab.archive'|trans({count: counts.archive|default(0)}) }}</a>
</nav>

{% include '@Support/support/_tickets.html.twig' %}
{% endblock %}
