{% set names = staff ? logins(rows|map(row => row.user)) : [] %}
{% embed '@Theme/_table.html.twig' with {live: true} %}
    {% block row %}
        <tr class="clickable-row" data-href="{{ path('support_ticket', {id: row.id}) }}">
            <td class="{{ table.aside('number') }}"><strong>{{ row.id }}</strong></td>
            {% if staff %}
                <td class="{{ table.aside('user') }}">{% include '@Theme/_user.html.twig' with {user: row.user, name: names[row.user.id]} only %}</td>
            {% endif %}
            <td class="{{ table.aside('subject') }}"><a href="{{ path('support_ticket', {id: row.id}) }}">{{ clip(row.subject, 60) }}</a></td>
            <td class="{{ table.aside('department') }}">{{ row.department }}</td>
            <td class="{{ table.aside('at') }}">{{ moment(row.lastMessageAt) }}</td>
            <td class="{{ table.aside('status') }}">{{ badge(row.status) }}</td>
        </tr>
    {% endblock %}

{% endembed %}
