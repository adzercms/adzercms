{
    "name": "adzercms/centrifugo",
    "type": "adzercms-module",
    "description": "Live page updates for AdzerCMS through a Centrifugo server",
    "keywords": [
        "adzercms",
        "symfony",
        "centrifugo",
        "realtime",
        "websocket"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "adzercms/contracts": "^1.0",
        "adzercms/realtime": "^1.0",
        "firebase/php-jwt": "^7.2",
        "symfony/clock": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/http-client-contracts": "^3.7",
        "symfony/http-foundation": "7.4.*"
    },
    "provide": {
        "adzercms/hub-implementation": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\Centrifugo\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\Centrifugo\\CentrifugoBundle"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
