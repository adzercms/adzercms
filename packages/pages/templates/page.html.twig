{% extends '@Design/layout.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}

{% block meta %}
    {% include '@Theme/_seo.html.twig' with {title: page.title, description: page.description ?? ''} only %}
    {% include '@Theme/_schema.html.twig' with {schema: view.schema} only %}
{% endblock %}

{% block page %}
    {% if view.heading or view.tabs %}
        {% embed '@Theme/_section.html.twig' with {heading: view.heading, level: 1, class: 'site-title', tabs: view.tabs} only %}
            {% block content %}{% if tabs %}{% include '@Theme/_tabs.html.twig' with {tabs: tabs} only %}{% endif %}{% endblock %}
        {% endembed %}
    {% endif %}
    {% for block in view.blocks %}{% include block.template with block only %}{% endfor %}
{% endblock %}
