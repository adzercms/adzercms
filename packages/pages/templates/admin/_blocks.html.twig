{% embed '@Theme/_table.html.twig' %}
    {% block row %}
        <tr{% if row.type %} data-record="{{ path('admin_page_block', {id: row.id}) }}"{% endif %}>
            {% include '@Theme/_row_handle.html.twig' with {id: row.id} %}
            <td class="{{ table.aside('type') }}">
                {% if row.type %}<strong>{{ row.type.label|trans }}</strong>{% else %}<strong>{{ row.block.type }}</strong> {{ badge(unavailable) }}{% endif %}
            </td>
            <td class="{{ table.aside('summary') }}">{{ clip(row.summary, 80) }}</td>
            {% include '@Theme/_row_actions.html.twig' with {drop: path('admin_page_block_drop', {id: row.id}), confirm: 'pages.block.drop_confirm'|trans({type: row.type ? row.type.label|trans : row.block.type})} %}
        </tr>
    {% endblock %}
{% endembed %}
