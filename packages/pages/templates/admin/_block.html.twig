{% include '@Theme/_modal_header.html.twig' with {title: types ? 'pages.block.new'|trans : type.label|trans} only %}

<div class="modal-body">
    {% for refusal in refusals %}<p class="flash flash-error">{{ refusal.reason|trans }}</p>{% endfor %}
    <form hx-post="{{ action }}" hx-target="#record">
        {{ csrf_field() }}
        {% for name, value in hidden|default({}) %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
        {% if types %}
            <div class="fields">
                <label>{{ 'pages.column.type'|trans }}
                    <select name="type" hx-get="{{ path('admin_page_block_new', {id: page.id}) }}" hx-trigger="change" hx-target="#record">
                        {% for key, choice in types %}
                            <option value="{{ key }}" {{ key == type.key ? 'selected' }}>{{ choice.label|trans }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
        {% endif %}
        <div class="fields aligned">
            {% for field in type.fields %}
                {% include '@Theme/_field_row.html.twig' with {field: field, id: 'block-' ~ field.name, name: 'value[' ~ field.name ~ ']', value: values[field.name], pictures: (album|default({route: 'pages_picture', params: {}}))|merge({drop: 'drop[' ~ field.name ~ ']', pick: pick|default(false)})} only %}
            {% endfor %}
        </div>
        <button type="submit">{{ submit|default('core.action.save')|trans }}</button>
    </form>
</div>
