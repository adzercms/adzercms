{
    "name": "adzercms/pages",
    "type": "adzercms-module",
    "description": "Site pages: pages of blocks with the live blocks of modules, a header menu, page SEO",
    "keywords": [
        "adzercms",
        "symfony",
        "pages",
        "cms",
        "website"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "adzercms/contracts": "^1.0",
        "adzercms/core": "^1.0",
        "adzercms/theme-implementation": "^1.0",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "doctrine/persistence": "^4.2",
        "symfony/dependency-injection": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/translation-contracts": "^3.7"
    },
    "require-dev": {
        "adzercms/admin": "^1.0",
        "adzercms/cabinet": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\Pages\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\Pages\\PagesBundle",
            "description": {
                "ru": "Страницы сайта: страницы из блоков с живыми блоками модулей, меню шапки, SEO страниц"
            },
            "categories": ["content"],
            "title": {
                "en": "Site pages",
                "ru": "Страницы сайта"
            }
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
