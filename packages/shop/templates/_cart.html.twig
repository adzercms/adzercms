{% if lines is empty %}
    <p class="empty-state">{{ 'shop.cart.empty'|trans }}</p>
{% else %}
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>{{ 'shop.column.product'|trans }}</th>
                    <th>{{ 'shop.column.price'|trans }}</th>
                    <th>{{ 'shop.field.quantity'|trans }}</th>
                    <th>{{ 'shop.column.sum'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for line in lines %}
                    <tr>
                        <td><a href="{{ path('shop_product', {id: line.product.id}) }}">{{ line.product.name }}</a>{% if line.variant %}<br><span class="muted">{{ line.variant.name }}</span>{% endif %}</td>
                        <td>{{ line.price|precise }}</td>
                        <td>
                            <form class="inline-change-form" method="post" action="{{ path('shop_cart_change') }}">
                                {{ csrf_field() }}{{ back_field() }}
                                <input type="hidden" name="line" value="{{ line.key }}">
                                <input type="number" name="quantity" value="{{ line.quantity }}" min="0" max="{{ constant('AdzerCMS\\Shop\\Cart::LIMIT') }}" aria-label="{{ 'shop.field.quantity'|trans }}" required>
                                <button type="submit" class="secondary">{{ 'shop.cart.change'|trans }}</button>
                            </form>
                        </td>
                        <td>{{ line.sum|precise }}</td>
                        <td class="row-actions">
                            <form method="post" action="{{ path('shop_cart_change') }}">
                                {{ csrf_field() }}{{ back_field() }}
                                <input type="hidden" name="line" value="{{ line.key }}">
                                <input type="hidden" name="quantity" value="0">
                                <button type="submit" class="secondary">{{ 'shop.cart.remove'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3">{{ 'shop.cart.total'|trans }}</th>
                    <th>{{ total|precise }}</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
{% endif %}
