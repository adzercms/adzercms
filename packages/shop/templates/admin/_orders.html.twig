{% embed '@Theme/_table.html.twig' %}
    {% block row %}
        <tr class="clickable-row" data-href="{{ path('admin_shop_order', {id: row.id}) }}">
            <td class="{{ table.aside('number') }}"><strong>{{ row.id }}</strong>{{ caption(row.name) }}</td>
            <td class="{{ table.aside('phone') }}">{{ row.phone|contact }}</td>
            <td class="{{ table.aside('total') }}">{{ row.total|precise }}</td>
            <td class="{{ table.aside('receipt') }}">{{ row.receipt.label|trans }}</td>
            <td class="{{ table.aside('payment') }}">{{ row.payment.label|trans }}</td>
            <td class="{{ table.aside('arrived') }}">{{ moment(row.arrived) }}</td>
            <td class="{{ table.aside('status') }}">{{ badge(row.status) }}</td>
        </tr>
    {% endblock %}
{% endembed %}
