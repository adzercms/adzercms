{% extends '@Theme/page.html.twig' %}

{% block title %}{{ 'shop.order.title'|trans({number: order.id}) }}{% endblock %}

{% block actions %}{{ badge(order.status) }}{% endblock %}

{% block page %}
{% include '@Shop/_order.html.twig' %}
{% if payable %}
    <form method="post" action="{{ path('shop_order_pay', {key: order.key}) }}">
        {{ csrf_field() }}
        <button type="submit">{{ 'shop.order.pay'|trans }}</button>
    </form>
{% endif %}
{% endblock %}
