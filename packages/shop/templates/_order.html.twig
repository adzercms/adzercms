<div class="table-responsive">
    <table>
        <thead>
            <tr>
                <th>{{ 'shop.column.product'|trans }}</th>
                <th>{{ 'shop.column.price'|trans }}</th>
                <th>{{ 'shop.field.quantity'|trans }}</th>
                <th>{{ 'shop.column.sum'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for item in order.items %}
                <tr>
                    <td>{{ item.name }}{% if item.variant %}<br><span class="muted">{{ item.variant }}</span>{% endif %}</td>
                    <td>{{ item.price|precise }}</td>
                    <td>{{ item.quantity }}</td>
                    <td>{{ item.sum|precise }}</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            {% if order.deliveryPrice %}
                <tr><th colspan="3">{{ 'shop.cart.delivery'|trans }}</th><th>{{ order.deliveryPrice|precise }}</th></tr>
            {% endif %}
            <tr><th colspan="3">{{ 'shop.cart.total'|trans }}</th><th>{{ order.total|precise }}</th></tr>
        </tfoot>
    </table>
</div>
<div class="info-grid">
    <div class="info-item">
        <span class="info-label">{{ order.receipt.label|trans }}</span>
        <span class="info-value">{{ order.pointAddress ?? order.address }}</span>
    </div>
    <div class="info-item">
        <span class="info-label">{{ 'shop.field.payment'|trans }}</span>
        <span class="info-value">{{ order.payment.label|trans }}</span>
    </div>
</div>
