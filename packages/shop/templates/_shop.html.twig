{% if groups is empty %}
    <p class="empty-state">{{ 'shop.storefront.empty'|trans }}</p>
{% else %}
    <nav class="tabs">
        {% for group in groups %}<a class="tab" href="#category-{{ group.category.id }}">{{ group.category.name }}</a>{% endfor %}
    </nav>
    {% for group in groups %}
        <section class="section" id="category-{{ group.category.id }}">
            <div class="section-head"><h2>{{ group.category.name }}</h2></div>
            <div class="offer-grid">
                {% for product in group.products %}
                    {% set page = path('shop_product', {id: product.id}) %}
                    <article class="offer-card" id="product-{{ product.id }}">
                        {% if product.photo %}<a href="{{ page }}"><img class="offer-photo" src="{{ path('shop_photo', {name: product.photo}) }}" alt="{{ product.name }}" loading="lazy"></a>{% endif %}
                        <h3 class="offer-title"><a href="{{ page }}">{{ product.name }}</a></h3>
                        <div class="offer-price">{% include '@Shop/_price.html.twig' %}</div>
                        <div class="offer-actions">
                            {% if product.variants is empty %}
                                <form method="post" action="{{ path('shop_cart_add') }}">
                                    {{ csrf_field() }}{{ back_field() }}
                                    <input type="hidden" name="product" value="{{ product.id }}">
                                    <input type="hidden" name="card" value="1">
                                    <button type="submit">{{ 'shop.cart.add'|trans }}</button>
                                </form>
                            {% else %}
                                <a class="button" href="{{ page }}">{{ 'shop.cart.choose'|trans }}</a>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endfor %}
{% endif %}
