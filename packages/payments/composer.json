{
    "name": "adzercms/payments",
    "type": "adzercms-module",
    "description": "Online payments for AdzerCMS: payment records, confirmation and acquiring modules",
    "keywords": [
        "adzercms",
        "symfony",
        "payments",
        "acquiring"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "adzercms/contracts": "^1.0",
        "adzercms/core": "^1.0",
        "adzercms/theme-implementation": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\Payments\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\Payments\\PaymentsBundle"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
