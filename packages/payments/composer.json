{
    "name": "adzercms/payments",
    "type": "adzercms-module",
    "description": "Online payments: payment history, confirmations and payment provider modules",
    "keywords": [
        "adzercms",
        "symfony",
        "payments",
        "acquiring"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "adzercms/contracts": "^1.0",
        "adzercms/core": "^1.0",
        "adzercms/theme-implementation": "^1.0",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "doctrine/persistence": "^4.2",
        "psr/event-dispatcher": "^1.0",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/polyfill-php86": "^1.43",
        "symfony/routing": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/translation-contracts": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\Payments\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\Payments\\PaymentsBundle",
            "description": {
                "ru": "Онлайн-оплата: история платежей, подтверждения и модули платёжных систем"
            },
            "categories": ["payments"]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
