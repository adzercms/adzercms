{
    "name": "adzercms/telegram-bot",
    "type": "adzercms-module",
    "description": "Telegram bot for notifications",
    "keywords": [
        "adzercms",
        "symfony",
        "telegram",
        "bot",
        "notifications"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "adzercms/contracts": "^1.0",
        "symfony/dependency-injection": "7.4.*",
        "symfony/http-client-contracts": "^3.7",
        "symfony/translation": "7.4.*"
    },
    "require-dev": {
        "adzercms/cabinet": "^1.0"
    },
    "provide": {
        "adzercms/bot-implementation": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\TelegramBot\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\TelegramBot\\TelegramBotBundle",
            "description": {
                "ru": "Бот Telegram для оповещений"
            },
            "categories": ["messaging"]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
