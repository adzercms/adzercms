    <unit id="telegrambot.guide.bot">
      <segment>
        <source>telegrambot.guide.bot</source>
        <target>Send /mybots to https://t.me/BotFather and pick the bot of the Telegram sign-in: the bot writes only to those who signed in through it</target>
      </segment>
    </unit>
    <unit id="telegrambot.guide.token">
      <segment>
        <source>telegrambot.guide.token</source>
        <target>Press "API Token" and copy the token from the reply into "Bot token"</target>
      </segment>
    </unit>
    <unit id="telegrambot.name">
      <segment>
        <source>telegrambot.name</source>
        <target>Telegram</target>
      </segment>
    </unit>
  </file>
