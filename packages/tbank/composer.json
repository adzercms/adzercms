{
    "name": "adzercms/tbank",
    "type": "adzercms-module",
    "description": "T-Bank online payments",
    "keywords": [
        "adzercms",
        "symfony",
        "payments",
        "acquiring",
        "tbank",
        "tinkoff"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "adzercms/contracts": "^1.0",
        "adzercms/core": "^1.0",
        "adzercms/payments": "^1.0",
        "symfony/dependency-injection": "7.4.*",
        "symfony/http-client-contracts": "^3.7",
        "symfony/http-foundation": "7.4.*",
        "symfony/translation": "7.4.*"
    },
    "provide": {
        "adzercms/payment-implementation": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\TBank\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\TBank\\TBankBundle",
            "description": {
                "ru": "Онлайн-оплата Т-Банка"
            },
            "categories": ["payments"]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
