  <file id="messages.ru">
    <unit id="googleanalytics.guide.measurement">
      <segment>
        <source>googleanalytics.guide.measurement</source>
        <target>Скопируйте «Идентификатор потока данных» из первой строки сведений о потоке, G- и знаки после него, в поле «Идентификатор потока данных»</target>
      </segment>
    </unit>
    <unit id="googleanalytics.guide.stream">
      <segment>
        <source>googleanalytics.guide.stream</source>
        <target>Откройте поток данных сайта; потока нет — «Добавить поток» → «Веб» с адресом сайта</target>
      </segment>
    </unit>
    <unit id="googleanalytics.guide.streams">
      <segment>
        <source>googleanalytics.guide.streams</source>
        <target>Откройте https://analytics.google.com, ресурс сайта, «Администратор» → «Сбор и редактирование данных» → «Потоки данных» → вкладка «Веб»</target>
      </segment>
    </unit>
    <unit id="googleanalytics.measurement">
      <segment>
        <source>googleanalytics.measurement</source>
        <target>Идентификатор потока данных</target>
      </segment>
    </unit>
    <unit id="googleanalytics.name">
      <segment>
        <source>googleanalytics.name</source>
        <target>Google Analytics</target>
      </segment>
    </unit>
