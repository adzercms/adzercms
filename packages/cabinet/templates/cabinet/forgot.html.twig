{% extends '@Cabinet/cabinet/auth.html.twig' %}

{% block title %}{{ 'cabinet.reset.title'|trans }}{% endblock %}

{% block subtitle %}<p class="auth-subtitle">{{ (code ? 'cabinet.reset.code_hint' : 'cabinet.reset.link_hint')|trans }}</p>{% endblock %}

{% block auth %}
<form method="post">
    {{ csrf_field() }}
    {% if error %}<p class="flash flash-error">{{ error|trans }}</p>{% endif %}
    <label>{{ 'cabinet.login.login'|trans }}
        <input type="text" name="login" value="{{ login }}" autocomplete="username" required autofocus>
    </label>
    {% include '@Cabinet/cabinet/_captcha.html.twig' %}
    <button class="wide" type="submit">{{ (code ? 'cabinet.reset.send_code' : 'cabinet.reset.send_link')|trans }}</button>
</form>

<p class="auth-links"><a href="{{ path('cabinet_login') }}">{{ 'cabinet.login.back'|trans }}</a></p>
{% endblock %}
