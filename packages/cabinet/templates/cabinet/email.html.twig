{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ 'cabinet.release.title'|trans }}{% endblock %}

{% block actions %}
    <a class="button secondary" href="{{ path('cabinet_profile') }}">{{ 'cabinet.profile.title'|trans }}</a>
{% endblock %}

{% block page %}
<div class="section">
    <p class="hint">{{ 'cabinet.email.hint'|trans({contact: contact}) }}</p>

    {% if awaited %}
        <form method="post" action="{{ path('cabinet_profile_email_code') }}" class="inline-change-form">
            {{ csrf_field() }}
            <label>{{ 'cabinet.contact.code_label'|trans({contact: phone}) }}
                <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required>
            </label>
            <button type="submit">{{ 'cabinet.contact.confirm'|trans }}</button>
            <button type="submit" class="secondary" form="email-cancel">{{ 'cabinet.contact.cancel'|trans }}</button>
        </form>
        <form id="email-cancel" method="post" action="{{ path('cabinet_profile_email_cancel') }}">{{ csrf_field() }}</form>
    {% else %}
        <div class="fields">
            <div class="field">
                <label>{{ 'cabinet.email.former'|trans }}</label>
                <div class="settings-value">{{ user.email }}</div>
                <form method="post" action="{{ path('cabinet_profile_email_ask', {way: 'former'}) }}" class="contact-change">
                    {{ csrf_field() }}<input type="hidden" name="contact" value="{{ contact }}">
                    <button class="small" type="submit">{{ 'cabinet.email.send'|trans }}</button>
                </form>
            </div>
            {% if phone %}
                <div class="field">
                    <label>{{ 'cabinet.email.phone'|trans }}</label>
                    <div class="settings-value">{{ phone }}</div>
                    <form method="post" action="{{ path('cabinet_profile_email_ask', {way: 'phone'}) }}" class="contact-change">
                        {{ csrf_field() }}<input type="hidden" name="contact" value="{{ contact }}">
                        <button class="small" type="submit">{{ 'cabinet.email.send'|trans }}</button>
                    </form>
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
