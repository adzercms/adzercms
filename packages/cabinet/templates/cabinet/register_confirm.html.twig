{% extends '@Cabinet/cabinet/auth.html.twig' %}

{% block title %}{{ 'cabinet.register.confirm_title'|trans }}{% endblock %}

{% block auth %}
{% if pending %}
    <form method="post" data-autosubmit>
        {{ csrf_field() }}
        <button class="wide" type="submit">{{ 'cabinet.register.open'|trans }}</button>
    </form>
{% else %}
    <p class="flash flash-error">{{ 'cabinet.contact.link'|trans }}</p>
    <p class="auth-links"><a href="{{ path('cabinet_register') }}">{{ 'cabinet.register.again'|trans }}</a></p>
{% endif %}
{% endblock %}
