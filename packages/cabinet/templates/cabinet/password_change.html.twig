{% extends '@Cabinet/cabinet/auth.html.twig' %}

{% block title %}{{ 'cabinet.password.title'|trans }}{% endblock %}

{% block subtitle %}<p class="auth-subtitle">{{ user.email }}</p>{% endblock %}

{% block auth %}
<form method="post">
    {{ csrf_field() }}
    {% if error %}<p class="flash flash-error">{{ error|trans }}</p>{% endif %}
    <label>{{ 'cabinet.password.new'|trans }}
        <input type="password" name="password" autocomplete="new-password" minlength="{{ password_min }}" required autofocus>
    </label>
    <label>{{ 'cabinet.password.repeat'|trans }}
        <input type="password" name="repeat" autocomplete="new-password" minlength="{{ password_min }}" required>
    </label>
    <button class="wide" type="submit">{{ 'core.action.save'|trans }}</button>
</form>
{% endblock %}
