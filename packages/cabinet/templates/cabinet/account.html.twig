{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ 'cabinet.menu.home'|trans }}{% endblock %}

{% block page %}
{% for part in fragments('cabinet.home', app.user.id) %}{% include part.template with part.context only %}{% endfor %}
{% if tabs|length > 1 %}
    <nav class="tabs">
        {% for key, entry in tabs %}
            <a class="tab {{ tab == key ? 'active' }}" href="{{ path('cabinet_account', {tab: key}) }}">{{ entry.tab.label|trans }}{% if entry.tab.count is not null %} ({{ entry.tab.count }}){% endif %}</a>
        {% endfor %}
    </nav>
{% endif %}

{% if fragment %}{% include fragment.template with fragment.context %}{% endif %}
{% endblock %}
