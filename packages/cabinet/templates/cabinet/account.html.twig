{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ 'cabinet.menu.home'|trans }}{% endblock %}

{% block actions %}{% for part in fragments('cabinet.home.actions', app.user.id) %}{% include part.template with part.context only %}{% endfor %}{% endblock %}

{% block page %}
{% if app.user.undeliverableAt %}
    <p class="flash flash-error"><a href="{{ path('cabinet_profile') }}">{{ 'cabinet.contact.bounced'|trans({contact: app.user.email}) }}</a></p>
{% endif %}
{% for part in fragments('cabinet.home', app.user.id) %}{% include part.template with part.context only %}{% endfor %}
{% if tabs|length > 1 %}
    {% include '@Theme/_tabs.html.twig' with {tabs: tabs|map((entry, key) => {label: entry.tab.label, count: entry.tab.count, href: path('cabinet_account', {tab: key}), active: tab == key})} only %}
{% endif %}

{% if fragment %}{% include fragment.template with fragment.context %}{% endif %}
{% endblock %}
