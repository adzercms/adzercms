{
    "name": "adzercms/sms-pilot",
    "type": "adzercms-module",
    "description": "SMSPilot SMS gateway for AdzerCMS notices and confirmation codes",
    "keywords": [
        "adzercms",
        "symfony",
        "sms",
        "sms-gateway",
        "smspilot"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "adzercms/contracts": "^1.0",
        "symfony/dependency-injection": "7.4.*",
        "symfony/http-client-contracts": "^3.7",
        "symfony/translation": "7.4.*"
    },
    "provide": {
        "adzercms/sms-implementation": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\SmsPilot\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\SmsPilot\\SmsPilotBundle"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
