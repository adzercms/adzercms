{
    "name": "adzercms/mts-marketolog",
    "type": "adzercms-module",
    "description": "SMS through MTS Marketolog: notifications and confirmation codes",
    "keywords": [
        "adzercms",
        "symfony",
        "sms",
        "sms-gateway",
        "mts"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "adzercms/contracts": "^1.0",
        "symfony/dependency-injection": "7.4.*",
        "symfony/http-client-contracts": "^3.7",
        "symfony/translation": "7.4.*",
        "symfony/uid": "7.4.*"
    },
    "provide": {
        "adzercms/sms-implementation": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AdzerCMS\\MtsMarketolog\\": "src/"
        }
    },
    "extra": {
        "adzercms": {
            "bundle": "AdzerCMS\\MtsMarketolog\\MtsMarketologBundle",
            "description": {
                "ru": "SMS через МТС Маркетолог: оповещения и коды подтверждения"
            },
            "categories": ["messaging"]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
