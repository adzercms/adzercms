{% for action in actions|default([]) %}
    {% if action.href is defined %}
        <a class="button" href="{{ action.href }}">{{ action.label|trans }}</a>
    {% elseif action.post|default(false) %}
        <form method="post" action="{{ path(action.route, action.params) }}">
            {{ csrf_field() }}
            <button type="submit">{{ action.label|trans }}</button>
        </form>
    {% else %}
        <button type="button" hx-get="{{ path(action.route, action.params) }}" hx-target="#record">{{ action.label|trans }}</button>
    {% endif %}
{% endfor %}
