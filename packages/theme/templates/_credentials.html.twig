{% include '@Theme/_modal_header.html.twig' with {title: (title|default('theme.credentials'))|trans} only %}

<form class="modal-body" method="post" action="{{ action }}" autocomplete="off">
    {{ csrf_field() }}{{ back_field() }}

    {% for field in fields %}
        <label>{{ field.label|trans }}{% if field.hint is defined %} {{ hint(field.hint|trans) }}{% endif %}
            <input type="text" name="{{ field.name }}" value="{{ field.value|default('') }}" autocomplete="off" spellcheck="false"
                   {{ field.required|default(false) ? 'required' }}
                   {% if field.mirror|default('') %}data-mirror="{{ field.mirror }}"{% endif %}
                   {% if field.secret %}class="secret"{% if field.stored|default(false) %} placeholder="••••••••"{% endif %}{% endif %}>
        </label>
    {% endfor %}

    <div class="button-row">
        <button type="submit">{{ 'core.action.save'|trans }}</button>
        {% if clearable|default(false) %}
            <button type="submit" class="danger" name="drop" value="1" formnovalidate
                    data-confirm="{{ 'theme.credentials_clear_confirm'|trans }}">{{ 'theme.clear'|trans }}</button>
        {% endif %}
    </div>
</form>
