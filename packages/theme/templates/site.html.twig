{% extends '@Theme/base.html.twig' %}

{% block bodyclass %}site{% endblock %}

{% block shell %}
<!--noindex--><header class="site-header" data-nosnippet>
    <div class="site-header-inner">
        <a class="header-logo" href="{{ site_root() }}">{% include '@Theme/_brand.html.twig' %}</a>
        <nav class="site-nav">{% for part in fragments(constant('AdzerCMS\\Contracts\\Ui\\Fragment::SITE_NAV')) %}{% include part.template with part.context only %}{% endfor %}</nav>
        {% set entry = app.user ? cabinet('home') : cabinet('login') %}
        {% if entry %}<a class="button site-entry" href="{{ entry }}">{{ (app.user ? 'theme.site.cabinet' : 'theme.site.login')|trans }}</a>{% endif %}
    </div>
</header><!--/noindex-->
<main class="site-main">{% block page %}{% endblock %}</main>
<!--noindex--><footer class="site-footer" data-nosnippet>
    <div class="site-footer-inner">
        {% if brand.footer %}<div class="prose">{{ brand.footer|markup }}</div>{% endif %}
        <p>© {{ 'now'|date('Y') }} {{ brand.title }}</p>
    </div>
</footer><!--/noindex-->
{% endblock %}
