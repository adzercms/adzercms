<form class="table-filters" hx-get="{{ path(route, params|default({})) }}" hx-trigger="change, submit" hx-target="closest .card" hx-select=".card"
      hx-swap="outerHTML" hx-push-url="true" hx-sync="this:replace">
    {% for filter in periods %}
        {% include '@Theme/_filter_field.html.twig' with {filter: filter} only %}
    {% endfor %}
</form>
