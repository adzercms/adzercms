{%- set w = 600 -%}
{%- set h = 120 -%}
{%- set levels = chart.levels|reverse -%}
<figure class="chart">
    <figcaption class="chart-head">
        <span class="chart-title">{{ chart.title|trans }}</span>
        <span class="chart-unit">{{ chart.unit|trans }}</span>
    </figcaption>

    <div class="chart-legend">
        {% for line in chart.lines %}
            <label class="chart-toggle">
                <input type="checkbox" checked data-line="{{ id }}-{{ line.key }}">{{ line.label|trans }}
            </label>
        {% endfor %}
    </div>

    <div class="chart-area">
        <div class="chart-axis">
            {% for level in levels %}
                <span class="chart-level" style="top: {{ ((1 - level / chart.ceiling) * 100)|round(2) }}%">
                    {{- level|round(chart.ceiling < 10 ? 1 : 0) -}}
                </span>
            {% endfor %}
        </div>

        <div class="chart-field" data-digits="{{ chart.ceiling < 10 ? 2 : (chart.ceiling < 100 ? 1 : 0) }}"
             data-moments="{{ chart.moments|map(moment => moment|trans)|join('|') }}"
             data-shares="{{ chart.shares|map(share => share|round(4))|join(',') }}">
            <svg class="chart-plot" viewBox="0 0 {{ w }} {{ h }}" preserveAspectRatio="none" role="img">
                {% for level in levels %}
                    {% set y = (h * (1 - level / chart.ceiling))|round(1) %}
                    <line class="chart-grid" x1="0" y1="{{ y }}" x2="{{ w }}" y2="{{ y }}"/>
                {% endfor %}
                {% for tick in chart.ticks %}
                    <line class="chart-grid" x1="{{ (tick.share * w)|round(1) }}" y1="0"
                          x2="{{ (tick.share * w)|round(1) }}" y2="{{ h }}"/>
                {% endfor %}
                {% for line in chart.lines %}
                    <path id="{{ id }}-{{ line.key }}" class="chart-line"
                        data-values="{{ line.values|map(value => value is null ? '' : value|round(3))|join(',') }}"
                        d="{% for segment in line.segments %}M{% for point in segment %}{{ ((point.0 - chart.from) / chart.span * w)|round(2) }},{{ (h - min(point.1, chart.ceiling) / chart.ceiling * h)|round(2) }} {% endfor %}{{ segment|length == 1 ? 'h0 ' }}{% endfor %}"/>
                {% endfor %}
            </svg>

            <div class="chart-probe" hidden>
                <div class="chart-readout">
                    <strong class="chart-moment"></strong>
                    {% for line in chart.lines %}
                        <span class="chart-value" data-of="{{ id }}-{{ line.key }}">
                            {{- line.label|trans }} <output></output> {{ chart.unit|trans -}}
                        </span>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="chart-times">
            {% for tick in chart.ticks %}
                <span class="chart-time" style="left: {{ (tick.share * 100)|round(2) }}%">{{ tick.label|trans }}</span>
            {% endfor %}
        </div>
    </div>
</figure>
