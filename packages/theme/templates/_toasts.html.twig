<div class="toasts" popover="manual">
    {%- if app.request.hasPreviousSession or (app.session and app.session.started) -%}
    {%- for label, messages in app.flashes -%}
        {%- for message in messages -%}
            <p class="toast toast-{{ label }}">{{ message|trans }}</p>
        {%- endfor -%}
    {%- endfor -%}
    {%- endif -%}
</div>
