{% extends '@Theme/base.html.twig' %}

{% block bodyclass %}site{% endblock %}

{% block shell %}
{% import '@Theme/_icons.html.twig' as icon %}
{% set nav = fragments(constant('AdzerCMS\\Contracts\\Ui\\Fragment::SITE_NAV')) %}
{% if nav %}<input type="checkbox" id="site-menu" class="site-menu-toggle" hidden>{% endif %}
<!--noindex--><header class="site-header" data-nosnippet>
    <div class="site-header-inner">
        <a class="header-logo" href="{{ site_root() }}">{% include '@Theme/_brand.html.twig' %}</a>
        <nav class="site-nav">{% for part in nav %}{% include part.template with part.context only %}{% endfor %}</nav>
        {% if brand.cabinetUrl %}
            <a class="button site-entry" href="{{ brand.cabinetUrl }}" target="_blank" rel="noopener">{{ 'theme.site.cabinet'|trans }}</a>
        {% else %}
            {% set entry = app.user ? cabinet('home') : cabinet('login') %}
            {% if entry %}<a class="button site-entry" href="{{ entry }}">{{ (app.user ? 'theme.site.cabinet' : 'theme.site.login')|trans }}</a>{% endif %}
        {% endif %}
        {% if nav %}
            <label class="menu-toggle" for="site-menu" aria-label="{{ 'theme.menu'|trans }}">
                {{ icon.glyph('menu') }}
            </label>
        {% endif %}
    </div>
</header><!--/noindex-->
<main class="site-main">{% block page %}{% endblock %}</main>
<!--noindex--><footer class="site-footer" data-nosnippet>
    <div class="site-footer-inner">
        {% if brand.footer %}<div class="prose">{{ brand.footer|markup }}</div>{% endif %}
        <p>© {{ 'now'|date('Y') }} {{ brand.title }}</p>
    </div>
</footer><!--/noindex-->
{% endblock %}
