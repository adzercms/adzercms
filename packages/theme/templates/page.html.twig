{% extends '@Theme/base.html.twig' %}

{% block body %}
<section class="card">
    <header class="card-head">
        <h1>{% block heading %}{{ block('title') }}{% endblock %}</h1>
        <div class="card-actions">{% block actions %}{% endblock %}</div>
    </header>

    {% block page %}{% endblock %}
</section>
{% endblock %}
