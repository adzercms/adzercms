<section class="site-section{{ class is defined ? ' ' ~ class }}"{% if id is defined %} id="{{ id }}"{% endif %}>
    <div class="site-section-inner">
        {% block eyebrow %}{% endblock %}
        {% if heading is defined and heading %}<h{{ level }} class="site-heading">{{ heading }}</h{{ level }}>{% endif %}
        {% block content %}{% endblock %}
    </div>
</section>
