{% for filter in table.filters|filter(filter => filter.tabs) %}
    {% include '@Theme/_tabs.html.twig' with {tabs: [{value: '', label: filter.label}]|merge(filter.options|map((label, value) => {value: value, label: label}))|map(option => {
        label: option.label,
        href: path(table.route, table.tab(filter, option.value)),
        select: table.id,
        active: table.value(filter.name) == option.value,
    })} only %}
{% endfor %}
{% set fields = table.filters|filter(filter => not filter.tabs) %}
{% if fields %}
    {% set action = path(table.route, table.base()) %}
    <form class="table-filters" hx-get="{{ action }}" hx-target="#{{ table.id }}" hx-select="#{{ table.id }}" hx-swap="outerHTML"
          hx-push-url="true" hx-sync="closest form:replace" hx-trigger="submit">
        {% for filter in table.filters|filter(filter => filter.tabs and table.value(filter.name)) %}
            <input type="hidden" name="{{ table.field(filter) }}" value="{{ table.value(filter.name) }}">
        {% endfor %}
        {% for filter in fields %}
            {% include '@Theme/_filter_field.html.twig' with {
                filter: filter,
                name: table.field(filter),
                value: table.value(filter.name) ?: filter.selected,
                id: table.id ~ '-' ~ filter.name,
                action: action,
                data: table.id ~ '-data',
                live: true,
            } only %}
        {% endfor %}
    </form>
{% endif %}
