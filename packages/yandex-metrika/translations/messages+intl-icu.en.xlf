  <file id="messages.en">
    <unit id="yandexmetrika.conversions_closed">
      <segment>
        <source>yandexmetrika.conversions_closed</source>
        <target>Yandex Metrica takes no offline conversions without the counter and its token</target>
      </segment>
    </unit>
    <unit id="yandexmetrika.conversions_refused">
      <segment>
        <source>yandexmetrika.conversions_refused</source>
        <target>Yandex Metrica refused the conversions: {reason}</target>
      </segment>
    </unit>
    <unit id="yandexmetrika.counter">
      <segment>
        <source>yandexmetrika.counter</source>
        <target>Counter number</target>
      </segment>
    </unit>
    <unit id="yandexmetrika.guide.allow">
      <segment>
        <source>yandexmetrika.guide.allow</source>
        <target>In the same account open https://oauth.yandex.ru/authorize?response_type=token&amp;client_id= with the ClientID at the end of the address and allow the access</target>
      </segment>
    </unit>
    <unit id="yandexmetrika.guide.app">
      <segment>
        <source>yandexmetrika.guide.app</source>
        <target>Signed in as the counter owner or a representative with edit rights, open https://oauth.yandex.ru/client/new, pick the app for API access or debugging, tick metrika:offline_data in data access, create the app and copy its ClientID</target>
      </segment>
    </unit>
    <unit id="yandexmetrika.guide.counter">
      <segment>
        <source>yandexmetrika.guide.counter</source>
        <target>Open the counter list https://metrika.yandex.ru/list and copy the counter number of the site into "Counter number"</target>
      </segment>
    </unit>
    <unit id="yandexmetrika.guide.token">
      <segment>
        <source>yandexmetrika.guide.token</source>
        <target>Copy the token from the page into "Token" through "Change" of the credentials</target>
      </segment>
    </unit>
    <unit id="yandexmetrika.name">
      <segment>
        <source>yandexmetrika.name</source>
        <target>Yandex Metrica</target>
      </segment>
    </unit>
    <unit id="yandexmetrika.token">
      <segment>
        <source>yandexmetrika.token</source>
        <target>Token</target>
      </segment>
    </unit>
    <unit id="yandexmetrika.unavailable">
      <segment>
        <source>yandexmetrika.unavailable</source>
        <target>Yandex Metrica is unavailable: {reason}</target>
      </segment>
    </unit>
