{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ 'admin.menu.modules'|trans }}{% endblock %}

{% block actions %}
    {% if tab == 'sources' %}
        {% include '@Theme/_actions.html.twig' with {actions: [
            {label: 'admin.sources.add', route: 'admin_module_source_new', params: {}},
            {label: 'admin.sources.upload', route: 'admin_module_zip', params: {}},
        ]} %}
    {% endif %}
{% endblock %}

{% block page %}
<nav class="tabs">
    {% for key, label in tabs %}
        <a class="tab {{ tab == key ? 'active' }}" href="{{ path('admin_modules', {tab: key}) }}">{{ label|trans }}</a>
    {% endfor %}
</nav>
{% if tab == 'sources' %}
    {% embed '@Theme/_table.html.twig' %}
        {% block row %}
            <tr>
                <td class="{{ table.aside('source') }}"><strong>{{ row.source }}</strong>{% if row.down %} {{ badge(row.down) }}{% endif %}</td>
                <td class="{{ table.aside('access') }}">{{ row.access ? 'admin.setting.set'|trans : blank() }}</td>
                <td class="row-actions">
                    {% if row.setting %}
                        {% include '@Theme/_actions.html.twig' with {actions: [{label: 'core.action.edit', href: row.setting}]} %}
                    {% endif %}
                    {% if row.credentials %}
                        {% include '@Theme/_actions.html.twig' with {actions: [{label: 'admin.setting.credentials', route: 'admin_module_source_credentials', params: {id: row.credentials}}]} %}
                    {% endif %}
                    {% if row.drop %}
                        <form method="post" action="{{ row.drop }}" data-confirm="{{ 'admin.sources.drop_confirm'|trans({source: row.source}) }}">
                            {{ csrf_field() }}
                            {% for name, value in row.hidden %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
                            <button type="submit">{{ 'core.action.drop'|trans }}</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% endblock %}
    {% endembed %}
{% elseif tab == 'operations' %}
    {% embed '@Theme/_table.html.twig' %}
        {% block row %}
            <tr>
                <td class="{{ table.aside('package') }}"><strong>{{ row.package }}</strong></td>
                <td class="{{ table.aside('action') }}">{{ row.action.label|trans }}</td>
                <td class="{{ table.aside('state') }}">
                    {{ badge(row.state) }}
                    {% if row.output %}<pre class="muted">{{ row.output }}</pre>{% endif %}
                </td>
                <td class="{{ table.aside('filed') }}">{{ 'core.moment.day_time'|trans({at: row.filed}) }}</td>
                <td class="{{ table.aside('finished') }}">{{ row.finished ? 'core.moment.day_time'|trans({at: row.finished}) : blank() }}</td>
            </tr>
        {% endblock %}
    {% endembed %}
{% else %}
    {% embed '@Theme/_table.html.twig' with {live: true} %}
        {% block items %}
            {% if tiles %}
                {% import '@Admin/admin/_extension.html.twig' as extension %}
                <div class="offer-grid">
                    {% for row in rows %}
                        <article class="offer-card{{ row.card ? ' clickable-row' }}" data-package="{{ row.name }}"{% if row.card %} data-href="{{ row.card }}"{% endif %}>
                            <h2 class="offer-title">{{ extension.name(row) }}</h2>
                            {% if row.description %}<p>{{ row.description }}</p>{% endif %}
                            <span class="muted">{{ extension.version(row) }}</span>
                            <span>{{ extension.state(row) }}</span>
                            {{ extension.demo(row) }}
                            <div class="offer-actions">{% include '@Theme/_actions.html.twig' with {actions: row.actions} %}</div>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                {{ parent() }}
            {% endif %}
        {% endblock %}
        {% block row %}
            {% import '@Admin/admin/_extension.html.twig' as extension %}
            <tr{% if row.card %} class="clickable-row" data-href="{{ row.card }}"{% endif %}>
                <td class="{{ table.aside('name') }}">
                    {{ extension.name(row) }}
                    {% if row.description %}<br><span class="muted">{{ row.description }}</span>{% endif %}
                    {% if row.demo %}<br>{{ extension.demo(row) }}{% endif %}
                </td>
                <td class="{{ table.aside('version') }}">{{ extension.version(row) }}</td>
                <td class="{{ table.aside('repository') }}">{{ row.repository ?: blank() }}</td>
                <td class="{{ table.aside('state') }}">{{ extension.state(row) }}</td>
                <td class="row-actions">{% include '@Theme/_actions.html.twig' with {actions: row.actions} %}</td>
            </tr>
        {% endblock %}
    {% endembed %}
{% endif %}
{% endblock %}
