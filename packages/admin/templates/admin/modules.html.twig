{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ 'admin.menu.modules'|trans }}{% endblock %}

{% block page %}
{% embed '@Theme/_table.html.twig' %}
    {% block row %}
        <tr class="clickable-row" data-href="{{ path('admin_module', {key: row.key}) }}">
            <td class="{{ table.aside('name') }}"><strong>{{ row.name }}</strong></td>
            <td class="{{ table.aside('kind') }}">{{ row.kind }}</td>
            <td class="{{ table.aside('schema') }}">{{ row.schema ?: blank() }}</td>
        </tr>
    {% endblock %}
{% endembed %}
{% embed '@Theme/_table.html.twig' with {table: catalog, rows: offers, heading: 'admin.catalog.title'} %}
    {% block above %}
        <p class="muted">{{ taken ? 'admin.catalog.taken'|trans({at: taken}) : 'admin.catalog.untaken'|trans }}</p>
    {% endblock %}
    {% block row %}
        <tr>
            <td class="{{ table.aside('name') }}">
                {% if row.link %}<a href="{{ row.link }}" target="_blank" rel="noopener"><strong>{{ row.name }}</strong></a>{% else %}<strong>{{ row.name }}</strong>{% endif %}
                {% if row.description %}<br><span class="muted">{{ row.description }}</span>{% endif %}
            </td>
            <td class="{{ table.aside('kind') }}">{{ row.kind }}</td>
            <td class="{{ table.aside('version') }}">{{ row.version ?: blank() }}</td>
            <td class="{{ table.aside('installed') }}">{{ row.installed ?: blank() }}</td>
            <td class="{{ table.aside('repository') }}">{{ row.repository ?: blank() }}</td>
        </tr>
    {% endblock %}
{% endembed %}
{% endblock %}
