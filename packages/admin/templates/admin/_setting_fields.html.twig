{% set type = 'AdzerCMS\\Contracts\\Setting\\Type::' %}
{% for block in sections %}
    <div class="section">
    {% if block.section %}<div class="section-head"><h3>{{ block.section|trans }}</h3></div>{% endif %}

    <div class="fields aligned">
        {% for field in block.fields %}
            {% set id = 'setting-' ~ field.name %}
            {% set stored = field.name in block.stored %}
            <div class="field">
                <label for="{{ id }}">{{ field.label|trans }}</label>
                {% if field.type == constant(type ~ 'Toggle') %}
                    <select id="{{ id }}" name="value[{{ field.name }}]">
                        {% for case in enum('AdzerCMS\\Core\\Setting\\Toggle').cases %}
                            <option value="{{ case.value }}" {{ values[field.name] == case.value ? 'selected' }}>{{ ('core.toggle.' ~ case.name|lower)|trans }}</option>
                        {% endfor %}
                    </select>
                {% elseif field.type == constant(type ~ 'Image') %}
                    {% include '@Theme/_file.html.twig' with {id: id, name: 'file[' ~ field.name ~ ']', accept: 'image/png,image/jpeg,image/svg+xml,image/webp,image/vnd.microsoft.icon'} only %}
                {% elseif field.type == constant(type ~ 'Container') %}
                    {% include '@Theme/_file.html.twig' with {id: id, name: 'file[' ~ field.name ~ ']', accept: '.p12,.pfx'} only %}
                {% elseif field.type == constant(type ~ 'Choice') %}
                    <select id="{{ id }}" name="value[{{ field.name }}]">
                        {% if values[field.name] == '' %}<option value="" selected>{{ 'admin.setting.unset'|trans }}</option>{% endif %}
                        {% for choice, caption in field.choices %}
                            <option value="{{ choice }}" {{ values[field.name] == choice ? 'selected' }}>{{ caption|trans }}</option>
                        {% endfor %}
                    </select>
                {% elseif field.type == constant(type ~ 'Palette') %}
                    {% include '@Theme/_palette.html.twig' with {id: id, name: 'value[' ~ field.name ~ ']', label: field.label, schemes: field.schemes, value: values[field.name]} only %}
                {% elseif field.type == constant(type ~ 'Color') %}
                    <input id="{{ id }}" type="color" name="value[{{ field.name }}]" value="{{ values[field.name] ?: '#000000' }}">
                {% elseif field.type == constant(type ~ 'Secret') %}
                    <input id="{{ id }}" type="text" class="secret" name="value[{{ field.name }}]" autocomplete="off" spellcheck="false">
                {% else %}
                    <input id="{{ id }}" type="text" name="value[{{ field.name }}]" value="{{ values[field.name] }}">
                {% endif %}

                {% if field.type == constant(type ~ 'Container') or stored %}
                    <div class="field-extra">
                        {% if field.type == constant(type ~ 'Container') %}
                            <label>{{ 'admin.setting.container_password'|trans }}
                                <input type="text" class="secret" name="pass[{{ field.name }}]" autocomplete="off" spellcheck="false">
                            </label>
                        {% endif %}

                        {% if field.type == constant(type ~ 'Image') and stored %}
                            <span class="brand-preview">
                                <img src="{{ path('setting_image', {name: field.name}) }}" alt="{{ values[field.name] }}">
                                <img src="{{ path('setting_image', {name: field.name}) }}" alt="">
                            </span>
                        {% endif %}

                        {% if stored %}
                            <button type="submit" class="secondary small" name="drop[{{ field.name }}]" value="1" formnovalidate>{{ (field.type == constant(type ~ 'Palette') ? 'admin.setting.reset' : 'admin.setting.drop')|trans }}</button>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}

        {% for key, credential in block.credentials %}
            <div class="field credential">
                <span class="credential-label">{{ 'admin.setting.credentials'|trans }}</span>
                <span class="credential-row">
                    {{ badge(credential) }}
                    <button type="button" class="secondary"
                            hx-get="{{ path('admin_settings_credentials', {key: key}) }}" hx-target="#record">{{ 'admin.setting.change'|trans }}</button>
                </span>
            </div>
        {% endfor %}
    </div>
    </div>
{% endfor %}
