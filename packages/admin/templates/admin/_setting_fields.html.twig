{% set type = 'AdzerCMS\\Contracts\\Setting\\Type::' %}
{% for block in sections %}
    <div class="section">
    {% if block.section %}<div class="section-head"><h3>{{ block.section|trans }}</h3></div>{% endif %}

    <div class="fields aligned">
        {% for field in block.fields %}
            {% set id = 'setting-' ~ field.name %}
            {% set stored = field.name in block.stored %}
            {% set rows = field.type == constant(type ~ 'Rows') %}
            <div class="field{{ rows or field.type == constant(type ~ 'Markup') ? ' field-wide' }}">
                <label for="{{ rows ? id ~ '-0-' ~ field.fields|first.name : id }}">{{ field.label|trans }}</label>
                {% if rows %}
                    <div class="field-rows" style="--columns: {{ field.fields|length }}">
                        {% for column in field.fields %}<span class="field-rows-head">{{ column.label|trans }}</span>{% endfor %}
                        {% for row in values[field.name] %}
                            {% set at = loop.index0 %}
                            {% for column in field.fields %}
                                {% include '@Admin/admin/_setting_control.html.twig' with {field: column, id: id ~ '-' ~ at ~ '-' ~ column.name, name: 'value[' ~ field.name ~ '][' ~ at ~ '][' ~ column.name ~ ']', value: row[column.name], label: column.label} only %}
                            {% endfor %}
                        {% endfor %}
                    </div>
                {% elseif field.type == constant(type ~ 'Image') %}
                    {% include '@Theme/_file.html.twig' with {id: id, name: 'file[' ~ field.name ~ ']', accept: constant('AdzerCMS\\Core\\Setting\\Images::TYPES')|keys|join(',')} only %}
                {% elseif field.type == constant(type ~ 'Photo') %}
                    {% include '@Theme/_file.html.twig' with {id: id, name: 'file[' ~ field.name ~ ']', accept: constant('AdzerCMS\\Core\\Photo\\Photos::TYPES')|join(',')} only %}
                {% elseif field.type == constant(type ~ 'Container') %}
                    {% include '@Theme/_file.html.twig' with {id: id, name: 'file[' ~ field.name ~ ']', accept: '.p12,.pfx'} only %}
                {% else %}
                    {% include '@Admin/admin/_setting_control.html.twig' with {field: field, id: id, name: 'value[' ~ field.name ~ ']', value: values[field.name]} only %}
                {% endif %}

                {% if field.type == constant(type ~ 'Container') or stored %}
                    <div class="field-extra">
                        {% if field.type == constant(type ~ 'Container') %}
                            <label>{{ 'admin.setting.container_password'|trans }}
                                <input type="text" class="secret" name="pass[{{ field.name }}]" autocomplete="off" spellcheck="false">
                            </label>
                        {% endif %}

                        {% if field.type.picture and stored %}
                            <span class="brand-preview">
                                <img src="{{ path('setting_image', {name: field.name}) }}" alt="{{ values[field.name] }}">
                                {% if field.type == constant(type ~ 'Image') %}<img src="{{ path('setting_image', {name: field.name}) }}" alt="">{% endif %}
                            </span>
                        {% endif %}

                        {% if stored %}
                            <button type="submit" class="secondary small" name="drop[{{ field.name }}]" value="1" formnovalidate>{{ (field.type == constant(type ~ 'Palette') ? 'admin.setting.reset' : 'admin.setting.drop')|trans }}</button>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}

        {% for key, credential in block.credentials %}
            <div class="field credential">
                <span class="credential-label">{{ 'admin.setting.credentials'|trans }}</span>
                <span class="credential-row">
                    {{ badge(credential) }}
                    <button type="button" class="secondary"
                            hx-get="{{ path('admin_settings_credentials', {key: key}) }}" hx-target="#record">{{ 'admin.setting.change'|trans }}</button>
                </span>
            </div>
        {% endfor %}
    </div>
    </div>
{% endfor %}
