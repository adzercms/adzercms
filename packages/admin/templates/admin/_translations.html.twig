<div hx-get="{{ path(table.route, table.params) }}" hx-trigger="{{ changed }} from:body" hx-target="#{{ table.id }}" hx-select="#{{ table.id }}" hx-swap="outerHTML">
{% embed '@Theme/_table.html.twig' %}
    {% block row %}
        <tr class="clickable-row" {% if row.href %}data-href="{{ row.href }}"{% else %}data-record="{{ path('admin_translation', {locale: locale, domain: row.domain, message: row.message}) }}"{% endif %}>
            <td class="{{ table.aside('text') }}">{% if row.stored %}<strong>{{ row.text }}</strong>{% else %}{{ row.text }}{% endif %}</td>
            <td class="{{ table.aside('message') }}">{{ row.message }}</td>
        </tr>
    {% endblock %}
{% endembed %}
</div>
