{% include '@Theme/_modal_header.html.twig' with {title: 'admin.sources.upload'|trans} only %}

<form class="modal-body" method="post" enctype="multipart/form-data" action="{{ path('admin_module_zip') }}">
    {{ csrf_field() }}
    <label>{{ 'admin.sources.archive'|trans }}
        {% include '@Theme/_file.html.twig' with {name: 'archive', accept: '.zip,application/zip', required: true} only %}
    </label>
    <div class="button-row">
        <button type="submit">{{ 'admin.sources.upload'|trans }}</button>
    </div>
</form>
