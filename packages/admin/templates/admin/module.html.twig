{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ module.title|trans }}{% endblock %}

{% block heading %}<span class="record-title">{{ module.title|trans }}</span>{% endblock %}

{% block actions %}
    {% if module.settings %}
        <a class="button" href="{{ path('admin_settings_module', {key: key}) }}">{{ 'admin.modules.settings'|trans }}</a>
    {% endif %}
    <a class="button secondary" href="{{ path('admin_modules') }}">{{ 'core.action.to_list'|trans }}</a>
{% endblock %}

{% block page %}
{% set description = module.description|trans %}
{% if description %}<p class="page-lead">{{ description }}</p>{% endif %}
<div class="info-grid">
    <div class="info-item">
        <span class="info-label">{{ 'admin.modules.schema'|trans }}</span>
        <span class="info-value">{{ moment(schema) }}</span>
    </div>
</div>
{% endblock %}
