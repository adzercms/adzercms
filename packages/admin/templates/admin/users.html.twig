{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ 'admin.menu.users'|trans }}{% endblock %}

{% block actions %}
    {% if creation %}<button type="button" hx-get="{{ path('admin_user_new') }}" hx-target="#record">{{ 'admin.users.add'|trans }}</button>{% endif %}
{% endblock %}

{% block page %}
{% include '@Theme/_tabs.html.twig' with {tabs: [
    {label: t('admin.users.tab', {count: counts.users}), href: path('admin_users'), active: not archive},
    {label: t('admin.users.archive', {count: counts.archive}), href: path('admin_users', {tab: 'archive'}), active: archive},
]} only %}

{% include '@Admin/admin/_users.html.twig' %}
{% endblock %}
