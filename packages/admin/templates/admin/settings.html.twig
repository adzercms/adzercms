{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ 'admin.menu.settings'|trans }}{% endblock %}

{% block page %}
<div class="subnav-layout">
    {% include '@Theme/_subnav.html.twig' with {groups: menu} only %}

    <div class="subnav-page">
        <h2>{{ label|trans }}</h2>

        {% if guide %}
            <div class="section">
                <div class="section-head"><h3>{{ 'admin.settings.guide'|trans }}</h3></div>
                <div class="prose">
                    <ol>
                        {% for step in guide %}
                            <li>{{ step|trans|links }}</li>
                        {% endfor %}
                    </ol>
                </div>
            </div>
        {% endif %}

        {% if sections %}
            <form method="post" enctype="multipart/form-data">
                {{ csrf_field() }}
                {% include '@Admin/admin/_setting_fields.html.twig' with {sections: sections, values: values} %}
                {% if sections|filter(block => block.fields)|length %}
                    <button type="submit">{{ 'core.action.save'|trans }}</button>
                {% endif %}
            </form>
        {% endif %}

        {% for part in fragments(place) %}{% include part.template with part.context only %}{% endfor %}
    </div>
</div>
{% endblock %}
