{% include '@Theme/_modal_header.html.twig' with {title: 'admin.user.new'|trans} only %}

<div class="modal-body">
    {% if error %}<p class="flash flash-error">{{ error|trans }}</p>{% endif %}

    <form hx-post="{{ path('admin_user_new') }}" hx-target="#record">
        {{ csrf_field() }}
        <div class="fields">
            {% if places %}
                <label>{{ place_label|trans }}
                    <select name="place">
                        {% if here %}<option value="">{{ 'admin.user.here'|trans }}</option>{% endif %}
                        {% for key, title in places %}
                            <option value="{{ key }}" {{ place == key ? 'selected' }}>{{ title }}</option>
                        {% endfor %}
                    </select>
                </label>
            {% endif %}
            {% include '@Admin/admin/_user_fields.html.twig' %}
            <label{% if places %} data-when="place="{% endif %}>{{ 'admin.user.notes'|trans }}
                <textarea name="note" rows="3">{{ user.note }}</textarea>
            </label>
            <label>{{ 'admin.user.password'|trans }}
                <input type="text" name="password" minlength="{{ password_min }}">
            </label>
        </div>
        <button type="submit">{{ 'core.action.create'|trans }}</button>
    </form>
</div>
