{% embed '@Theme/_table.html.twig' %}
    {% block row %}
        {% set contact = row.email ?? row.phone %}
        <tr class="clickable-row" data-href="{{ path('admin_user', {id: row.id}) }}">
            <td class="{{ table.aside('id') }}">{% include '@Theme/_user.html.twig' with {user: row, name: logins[row.id]} only %}</td>
            <td class="{{ table.aside('contact') }}">{{ clip(contact, 24) }}</td>
            {% for column in extra %}
                <td class="{{ table.aside(column.key) }}">{{ cell(cells[row.id][column.key] ?? null) }}</td>
            {% endfor %}
            <td class="{{ table.aside('state') }}">{{ badge(row.status) }}</td>
            <td class="{{ table.aside('created') }}">{{ 'core.moment.day'|trans({at: row.createdAt}) }}</td>
        </tr>
    {% endblock %}
{% endembed %}
