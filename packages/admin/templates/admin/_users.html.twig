{% embed '@Theme/_table.html.twig' %}
    {% block row %}
        <tr class="clickable-row" data-href="{{ path('admin_user', {id: row.id}) }}">
            <td class="{{ table.aside('id') }}">
                <strong>{{ logins[row.id] }}</strong>
                {{ caption(row.comment) }}
            </td>
            <td class="{{ table.aside('created') }}">{{ row.createdAt|date('d.m.Y') }}</td>
            {% for column in extra %}
                {% set value = cells[row.id][column.key] ?? null %}
                <td class="{{ table.aside(column.key) }} {{ value and value.sign < 0 ? 'minus' }} {{ value and value.sign > 0 ? 'plus' }}">{{ cell(value ? value.text : null) }}</td>
            {% endfor %}
            <td class="{{ table.aside('state') }}">{{ badge(row.status) }}</td>
        </tr>
    {% endblock %}
{% endembed %}
