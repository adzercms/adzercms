{% include '@Theme/_modal_header.html.twig' with {title: 'admin.user.new_password'|trans} only %}

<div class="modal-body">
    {% if issued %}
        <p>{{ 'admin.user.password_replaced'|trans({id: user.id}) }}</p>
        <div class="credential">
            <span class="credential-label">{{ 'admin.user.new_password'|trans }}</span>
            <span class="credential-row">
                <input type="text" id="issued-password" value="{{ issued }}" readonly>
                {% include '@Theme/_copy.html.twig' with {target: '#issued-password'} only %}
            </span>
        </div>
        <p class="hint">{{ mailed
            ? 'admin.user.password_mailed'|trans({email: user.email})
            : 'admin.user.password_unmailed'|trans }}</p>
    {% else %}
        {% if error|default(null) %}<p class="flash flash-error">{{ error|trans }}</p>{% endif %}
        <form hx-post="{{ path('admin_user_password', {id: user.id}) }}" hx-target="#record">
            {{ csrf_field() }}
            <div class="fields">
                <label class="field-wide">{{ 'admin.user.password'|trans }}
                    <input type="text" name="password" value="{{ password }}"
                           minlength="{{ password_min }}" autocomplete="off" required>
                    <p class="hint">{{ 'admin.user.password_issued'|trans }}</p>
                </label>
            </div>
            {% if user.email %}
                {% include '@Theme/_check.html.twig' with {name: 'mail', on: true, label: 'admin.user.password_send'|trans({email: user.email})} only %}
            {% else %}
                <p class="hint">{{ 'admin.user.password_no_mail'|trans }}</p>
            {% endif %}
            <button type="submit">{{ 'admin.user.password_issue'|trans }}</button>
        </form>
    {% endif %}
</div>
