{% extends '@Theme/panel.html.twig' %}

{% block title %}{{ project.name }}{% endblock %}

{% block heading %}<span class="record-title">{{ project.name }}</span>{% endblock %}

{% block actions %}
    <button type="button" hx-get="{{ path('builder_project_page_new', {id: project.id}) }}" hx-target="#record">{{ 'pages.new'|trans }}</button>
    <button type="button" class="secondary" hx-get="{{ path('builder_project_access', {id: project.id}) }}" hx-target="#record">{{ 'builder.access.current'|trans({access: project.access.label|trans}) }}</button>
    {% if project.access != constant('AdzerCMS\\Builder\\ProjectAccess::Personal') %}
        <button type="button" class="secondary" hx-get="{{ path('builder_project_version', {id: project.id}) }}" hx-target="#record">{{ 'builder.version.action'|trans }}</button>
    {% endif %}
    <a class="button secondary" href="{{ path('builder_project_file', {id: project.id}) }}" download>{{ 'builder.project.download'|trans }}</a>
    {% if transfer %}
        <form method="post" action="{{ path('builder_project_transfer_cancel', {id: project.id}) }}">
            {{ csrf_field() }}<button type="submit" class="secondary">{{ 'builder.transfer.cancel'|trans }}</button>
        </form>
    {% elseif project.access == constant('AdzerCMS\\Builder\\ProjectAccess::Personal') %}
        <button type="button" class="secondary" hx-get="{{ path('builder_project_transfer', {id: project.id}) }}" hx-target="#record">{{ 'builder.transfer.action'|trans }}</button>
    {% endif %}
    <form method="post" action="{{ path('builder_project_drop', {id: project.id}) }}" data-confirm="{{ 'builder.project.drop_confirm'|trans({name: project.name}) }}">
        {{ csrf_field() }}<button type="submit" class="danger">{{ 'builder.project.drop'|trans }}</button>
    </form>
    <a class="button secondary" href="{{ path('builder_projects') }}">{{ 'core.action.to_list'|trans }}</a>
{% endblock %}

{% block page %}
{% if version %}
<div class="section" data-version>
    <img class="table-cover" src="{{ path('builder_version_picture', {id: version.id, file: version.cover}) }}" alt="">
    <p>{{ 'builder.version.current'|trans({name: version.name, decision: ('builder.version.' ~ version.decision.value)|trans}) }}</p>
    {% if version.reason %}<p>{{ 'core.moderation.reason'|trans }}: {{ version.reason }}</p>{% endif %}
</div>
{% endif %}
{% if transfer %}
<div class="section">
    <p data-transfer>{{ 'builder.transfer.pending'|trans({recipient: login(transfer.recipient), expires: transfer.expires}) }}</p>
</div>
{% endif %}
{% include '@Builder/cabinet/_pages.html.twig' %}
{% endblock %}
