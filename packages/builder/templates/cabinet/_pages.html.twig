{% embed '@Theme/_table.html.twig' %}
    {% block row %}
        <tr>
            {% include '@Theme/_row_handle.html.twig' with {id: row.id} %}
            <td class="{{ table.aside('title') }}"><strong>{{ clip(row.title, 60) }}</strong></td>
            <td class="{{ table.aside('path') }}">{{ clip(row.path, 60) }}</td>
            {% include '@Theme/_row_actions.html.twig' with {drop: path('builder_project_page_drop', {id: project.id, page: row.id}), confirm: 'pages.page.drop_confirm'|trans({title: row.title})} %}
        </tr>
    {% endblock %}
{% endembed %}
