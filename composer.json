{
    "name": "adzercms/engine",
    "type": "project",
    "description": "AdzerCMS development application: all engine packages from path repositories",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "adzercms/admin": "^1.0@dev",
        "adzercms/cabinet": "^1.0@dev",
        "adzercms/centrifugo": "^1.0@dev",
        "adzercms/contracts": "^1.0@dev",
        "adzercms/core": "^1.0@dev",
        "adzercms/extensions": "^1.0@dev",
        "adzercms/hcaptcha": "^1.0@dev",
        "adzercms/mailing": "^1.0@dev",
        "adzercms/max-bot": "^1.0@dev",
        "adzercms/mts-marketolog": "^1.0@dev",
        "adzercms/payments": "^1.0@dev",
        "adzercms/realtime": "^1.0@dev",
        "adzercms/sber-id": "^1.0@dev",
        "adzercms/smart-captcha": "^1.0@dev",
        "adzercms/sms-pilot": "^1.0@dev",
        "adzercms/support": "^1.0@dev",
        "adzercms/tbank": "^1.0@dev",
        "adzercms/telegram": "^1.0@dev",
        "adzercms/telegram-bot": "^1.0@dev",
        "adzercms/theme": "^1.0@dev",
        "adzercms/turnstile": "^1.0@dev",
        "adzercms/vk-id": "^1.0@dev",
        "adzercms/yandex-id": "^1.0@dev",
        "adzercms/yookassa": "^1.0@dev",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.11",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "nikic/php-parser": "^5.9",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4.3",
        "psr/log": "^3.0.2",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/browser-kit": "7.4.*",
        "symfony/process": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdzerCMS\\Admin\\Tests\\": "packages/admin/tests/",
            "AdzerCMS\\Cabinet\\Tests\\": "packages/cabinet/tests/",
            "AdzerCMS\\Centrifugo\\Tests\\": "packages/centrifugo/tests/",
            "AdzerCMS\\Core\\Tests\\": "packages/core/tests/",
            "AdzerCMS\\Extensions\\Tests\\": "packages/extensions/tests/",
            "AdzerCMS\\HCaptcha\\Tests\\": "packages/hcaptcha/tests/",
            "AdzerCMS\\Mailing\\Tests\\": "packages/mailing/tests/",
            "AdzerCMS\\MaxBot\\Tests\\": "packages/max-bot/tests/",
            "AdzerCMS\\MtsMarketolog\\Tests\\": "packages/mts-marketolog/tests/",
            "AdzerCMS\\Payments\\Tests\\": "packages/payments/tests/",
            "AdzerCMS\\Realtime\\Tests\\": "packages/realtime/tests/",
            "AdzerCMS\\SberId\\Tests\\": "packages/sber-id/tests/",
            "AdzerCMS\\SmartCaptcha\\Tests\\": "packages/smart-captcha/tests/",
            "AdzerCMS\\SmsPilot\\Tests\\": "packages/sms-pilot/tests/",
            "AdzerCMS\\Support\\Tests\\": "packages/support/tests/",
            "AdzerCMS\\TBank\\Tests\\": "packages/tbank/tests/",
            "AdzerCMS\\Telegram\\Tests\\": "packages/telegram/tests/",
            "AdzerCMS\\TelegramBot\\Tests\\": "packages/telegram-bot/tests/",
            "AdzerCMS\\Theme\\Tests\\": "packages/theme/tests/",
            "AdzerCMS\\Turnstile\\Tests\\": "packages/turnstile/tests/",
            "AdzerCMS\\VkId\\Tests\\": "packages/vk-id/tests/",
            "AdzerCMS\\YandexId\\Tests\\": "packages/yandex-id/tests/",
            "AdzerCMS\\YooKassa\\Tests\\": "packages/yookassa/tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "scripts": {
        "post-install-cmd": ["@importmap"],
        "post-update-cmd": ["@importmap"],
        "importmap": "for map in vendor/adzercms/*/importmap.php; do \"$PHP_BINARY\" vendor/bin/adzercms-package-console \"$(dirname \"$map\")\" importmap:install --env=dev || exit 1; done"
    }
}
